{
  "kind": "collectionType",
  "collectionName": "projects",
  "info": {
    "singularName": "project",
    "pluralName": "projects",
    "displayName": "Project",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "chips": {
      "type": "component",
      "repeatable": true,
      "component": "shared.text-item"
    },
    "excerpt": {
      "type": "text"
    },
    "description": {
      "type": "blocks"
    },
    "specs": {
      "type": "component",
      "repeatable": true,
      "component": "shared.spec"
    },
    "priceFrom": {
      "type": "integer",
      "min": 0
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images",
        "videos"
      ]
    },
    "kitchen": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::kitchen.kitchen"
    },
    "legacyPath": {
      "type": "string"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
