{
  "kind": "collectionType",
  "collectionName": "kitchens",
  "info": {
    "singularName": "kitchen",
    "pluralName": "kitchens",
    "displayName": "Kitchen",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::kitchen-category.kitchen-category",
      "inversedBy": "kitchens"
    },
    "price": {
      "type": "integer",
      "required": true,
      "min": 0
    },
    "oldPrice": {
      "type": "integer",
      "min": 0
    },
    "dimensions": {
      "type": "string"
    },
    "height": {
      "type": "string"
    },
    "shortDesc": {
      "type": "string"
    },
    "description": {
      "type": "blocks"
    },
    "highlights": {
      "type": "component",
      "repeatable": true,
      "component": "kitchen.highlight"
    },
    "style": {
      "type": "enumeration",
      "enum": [
        "modern",
        "minimalist",
        "neoclassical",
        "loft",
        "classic",
        "scandinavian"
      ],
      "default": "modern"
    },
    "facade": {
      "type": "enumeration",
      "enum": [
        "mdf",
        "laminate",
        "painted",
        "hpl",
        "acrylic",
        "solid-wood"
      ],
      "default": "mdf"
    },
    "color": {
      "type": "enumeration",
      "enum": [
        "light",
        "dark",
        "wood",
        "colored"
      ],
      "default": "light"
    },
    "badge": {
      "type": "string"
    },
    "isHit": {
      "type": "boolean",
      "default": false
    },
    "specs": {
      "type": "component",
      "repeatable": true,
      "component": "shared.spec"
    },
    "included": {
      "type": "component",
      "repeatable": true,
      "component": "shared.text-item"
    },
    "excluded": {
      "type": "component",
      "repeatable": true,
      "component": "shared.text-item"
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images",
        "videos"
      ]
    },
    "legacyPath": {
      "type": "string",
      "description": "Legacy URL on the previous site — used for a 301 redirect"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },
    "tags": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::kitchen-tag.kitchen-tag",
      "inversedBy": "kitchens"
    },
    "reviews": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::review.review",
      "mappedBy": "kitchen"
    }
  }
}
